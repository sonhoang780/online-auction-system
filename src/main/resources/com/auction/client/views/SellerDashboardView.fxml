<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" 
            stylesheets="@../../../css/styles.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.auction.client.controller.SellerDashboardController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
            </padding>
            <Button onAction="#handleBack" styleClass="btn-secondary" text="⬅ Quay lại" />
            <Label text="📦 KÊNH QUẢN LÝ SẢN PHẨM &amp; TẠO PHIÊN ĐẤU GIÁ (SELLER)" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
        </HBox>
    </top>

    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>

            <!-- Form đăng ký sản phẩm mới -->
            <VBox prefWidth="380.0" spacing="12.0" styleClass="card-panel">
                <Label text="Đăng ký phiên đấu giá mới" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                
                <Label text="Tên sản phẩm:" style="-fx-font-weight: bold;" />
                <TextField fx:id="txtTitle" promptText="Ví dụ: Laptop Dell XPS 15" />

                <Label text="Mô tả sản phẩm:" style="-fx-font-weight: bold;" />
                <TextArea fx:id="txtDescription" promptText="Tình trạng, phụ kiện đi kèm..." prefHeight="80.0" />

                <Label text="Giá khởi điểm (VNĐ):" style="-fx-font-weight: bold;" />
                <TextField fx:id="txtStartPrice" promptText="10000000" />

                <Label text="Bước giá tối thiểu (VNĐ):" style="-fx-font-weight: bold;" />
                <TextField fx:id="txtStepPrice" promptText="200000" />

                <Button onAction="#handleCreateAuction" maxWidth="Infinity" styleClass="btn-primary" text="Tạo phiên đấu giá" />
            </VBox>

            <!-- Danh sách sản phẩm của Seller -->
            <VBox spacing="12.0" styleClass="card-panel" HBox.hgrow="ALWAYS">
                <Label text="Sản phẩm của tôi" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1e293b;" />
                <TableView fx:id="tblMyItems" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="90.0" text="Mã" />
                        <TableColumn fx:id="colTitle" prefWidth="200.0" text="Tên sản phẩm" />
                        <TableColumn fx:id="colCurrentPrice" prefWidth="120.0" text="Giá hiện tại" />
                        <TableColumn fx:id="colStatus" prefWidth="110.0" text="Trạng thái" />
                    </columns>
                </TableView>
            </VBox>
        </HBox>
    </center>
</BorderPane>
