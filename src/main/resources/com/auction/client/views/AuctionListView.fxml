<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="650.0" prefWidth="950.0" 
            stylesheets="@../../../css/styles.css" 
            xmlns="http://javafx.com/javafx/21" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="com.auction.client.controller.AuctionListController">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-background-color: #ffffff; -fx-border-color: #e2e8f0; -fx-border-width: 0 0 1 0;">
            <padding>
                <Insets bottom="15.0" left="25.0" right="25.0" top="15.0" />
            </padding>
            <Label text="⚡ CÁC PHIÊN ĐẤU GIÁ TRỰC TIẾP" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #1e3a8a;" />
            <HBox HBox.hgrow="ALWAYS" />
            <Label fx:id="lblWelcomeUser" style="-fx-font-weight: bold; -fx-text-fill: #0f172a;" text="Xin chào, User" />
            <Button onAction="#handleOpenSellerDashboard" styleClass="btn-secondary" text="📦 Kênh Người Bán" />
            <Button onAction="#handleOpenAdminDashboard" styleClass="btn-secondary" text="🛡️ Quản Trị Viên" />
            <Button onAction="#handleLogout" styleClass="btn-danger" text="Đăng xuất" />
        </HBox>
    </top>

    <center>
        <VBox spacing="15.0">
            <padding>
                <Insets bottom="20.0" left="25.0" right="25.0" top="20.0" />
            </padding>
            <Label text="Danh sách các phiên đang mở đặt giá realtime:" style="-fx-font-size: 14px; -fx-text-fill: #475569;" />
            <TableView fx:id="tblAuctions" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colId" prefWidth="90.0" text="Mã phiên" />
                    <TableColumn fx:id="colTitle" prefWidth="250.0" text="Tên sản phẩm" />
                    <TableColumn fx:id="colCurrentPrice" prefWidth="150.0" text="Giá hiện tại" />
                    <TableColumn fx:id="colStepPrice" prefWidth="120.0" text="Bước giá" />
                    <TableColumn fx:id="colHighestBidder" prefWidth="130.0" text="Người giữ giá" />
                    <TableColumn fx:id="colStatus" prefWidth="90.0" text="Trạng thái" />
                    <TableColumn fx:id="colAction" prefWidth="100.0" text="Thao tác" />
                </columns>
            </TableView>
        </VBox>
    </center>
</BorderPane>
